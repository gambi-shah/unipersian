[2026/09/23 v0.2.0 pdfTeX support for unipersian]

\makeatletter


\providecommand{\persianmainlanguage}{farsi}


% ------------------------------------------------
% DeclareUnicodeCharacters
% ------------------------------------------------
% U+0654 = ARABIC HAMZA ABOVE
\DeclareUnicodeCharacter{0654}{\makebox[0pt][r]{
        \raisebox{1.11ex}{ء}
        \kern 0.12em}}

\makeatother
\endinput