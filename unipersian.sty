\NeedsTeXFormat{LaTeX2e}

\def\uper@year{2026}
\def\uper@month{09}
\def\uper@day{08}
\def\uper@date{%
  \uper@year/\uper@month/\uper@day
}
\def\uper@version{0.1.0}

\ProvidesPackage{unipersian}
[\uper@date v\uper@version Persian support for pdfTeX, XeTeX, and LuaTeX]


